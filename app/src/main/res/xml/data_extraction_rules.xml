<?xml version="1.0" encoding="utf-8"?>
<!--
  Card 16a: the encrypted note files (files/att/) never leave through Android's cloud backup or a phone-to-phone
  transfer. Each file's key is in the database, so a transferred file would arrive without a usable key.
  android:allowBackup="false" stays in the manifest; this file also covers device transfer, which allowBackup alone
  may not stop on current Android.
-->
<data-extraction-rules>
    <!-- Card 26d: files/models/ holds a speech model pack (about 141 MB) that any phone can import again. -->
    <cloud-backup>
        <exclude domain="file" path="att/" />
        <exclude domain="file" path="models/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="att/" />
        <exclude domain="file" path="models/" />
    </device-transfer>
</data-extraction-rules>
